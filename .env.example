# Required: generate a unique 32+ character secret per deployment.
# Used for session cookies and AES-GCM encryption of Bitwarden secrets + org tokens in Redis.
# Startup rejects example placeholders.
APP_SECRET=change-me-to-a-long-random-string

# Optional alias (used if APP_SECRET is unset)
# CREDENTIALS_KEY=

# Set true when the app is served over HTTPS (reverse proxy / TLS).
# COOKIE_SECURE=false

# Override data directory for CLI home + branding (Docker defaults to /app/data).
# DATA_DIR=

# Redis is required (primary store). Compose password for the redis service.
REDIS_PASSWORD=change-me-redis-password

# Required for local `npm run dev` when Redis is reachable on the host.
# Compose injects REDIS_URL automatically for the app service.
# REDIS_URL=redis://:change-me-redis-password@127.0.0.1:6379
