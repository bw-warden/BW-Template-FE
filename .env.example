# Required: generate a unique 32+ character secret per deployment.
# Used for session cookies and AES-GCM encryption of Bitwarden API secrets
# (SQLite) and org API tokens (Redis). Startup rejects example placeholders.
# Do not reuse this placeholder value in a real deployment.
APP_SECRET=change-me-to-a-long-random-string

# Optional alias (used if APP_SECRET is unset)
# CREDENTIALS_KEY=

# Set true when the app is served over HTTPS (reverse proxy / TLS).
# COOKIE_SECURE=false

# Override data directory (Docker defaults to /app/data).
# DATA_DIR=

# Redis (Docker Compose): password for the redis service. Required when using compose.
# Generate a random value; the app receives REDIS_URL=redis://:PASSWORD@redis:6379.
REDIS_PASSWORD=change-me-redis-password

# Optional for local `npm run dev`: full Redis URL. Leave unset to disable Redis
# and use in-memory token cache + SQLite groups only.
# REDIS_URL=redis://:change-me-redis-password@127.0.0.1:6379
